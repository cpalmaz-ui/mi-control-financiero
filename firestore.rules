rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsAccount(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validBackup() {
      let data = request.resource.data;
      return data.keys().hasOnly(['payload', 'schemaVersion', 'revision', 'updatedAt'])
        && data.payload is string
        && data.payload.size() > 0
        && data.payload.size() <= 900000
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.revision is int
        && data.updatedAt == request.time;
    }

    match /users/{uid}/records/app-state {
      allow get: if ownsAccount(uid);
      allow create: if ownsAccount(uid) && validBackup()
        && request.resource.data.revision == 1;
      allow update: if ownsAccount(uid) && validBackup()
        && request.resource.data.revision == resource.data.revision + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
