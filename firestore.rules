rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validRecord() {
      return request.resource.data.keys().hasOnly(['payload','updatedAt','schemaVersion'])
        && request.resource.data.payload is map
        && request.resource.data.schemaVersion is int
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['createdAt','schemaVersion'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /records/{recordId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && validRecord();
        allow delete: if false;
      }
      match /audit/{eventId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['action','recordId','createdAt','detail'])
          && request.resource.data.action is string
          && request.resource.data.recordId is string
          && request.resource.data.detail is map
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}